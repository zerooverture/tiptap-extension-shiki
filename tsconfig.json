{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ES2015",
    "lib": ["es2015", "dom"],
    "moduleResolution": "node",
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
